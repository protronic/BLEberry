{
  "_id": "wba6dk_berry_v1",
  "name": "WBA6-DK Berry",
  "version": "v1",
  "description": "STM32WBA65I-DK1 mit Berry-REPL über BLE NUS: Mini-SPS, Eskalation, Signale (User-LEDs), Die-Temperatursensor, Joystick und Arduino-R3-GPIOs als Kanäle, Debug-Log.",
  "blocks": [
    "mini_sps_task",
    "sps_wait_ms",
    "sps_digital_input",
    "sps_digital_output",
    "sensor_ready",
    "sensor_temp",
    "escalation_rule",
    "signal_set",
    "monitor_value",
    "log_print"
  ],
  "channels": {
    "inputs": [
      "JOY_UP",
      "JOY_DOWN",
      "JOY_LEFT",
      "JOY_RIGHT",
      "JOY_SELECT",
      "D2",
      "D4",
      "D7",
      "D8"
    ],
    "outputs": [
      "LED0",
      "LED1",
      "D5",
      "D6",
      "D9",
      "D10"
    ]
  }
}

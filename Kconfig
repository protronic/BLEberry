menu "BLEberry - Berry REPL over BLE NUS"

config BLEBERRY_ECHO
	bool "Echo received characters back over NUS"
	help
	  Enable this when the connected terminal does not display the
	  characters it sends (raw character terminals). Most mobile NUS
	  terminal apps (nRF Toolbox, Serial Bluetooth Terminal) show sent
	  lines themselves, so the default is off.

config BLEBERRY_LINE_MAX
	int "Maximum REPL input line length"
	default 256

config BLEBERRY_RX_RINGBUF_SIZE
	int "Receive ring buffer size in bytes"
	default 1024

config BLEBERRY_TX_BUF_SIZE
	int "Transmit coalescing buffer size in bytes"
	default 244

config BLEBERRY_REPL_STACK_SIZE
	int "Stack size of the Berry REPL thread"
	default 12288
	help
	  The Berry compiler uses recursive descent parsing, so the REPL
	  thread needs a generous stack.

config BLEBERRY_TICK_MS
	int "Scheduler tick for sps.every() tasks in ms"
	default 10
	help
	  While the REPL waits for input it periodically runs due
	  BlockBerry mini-PLC tasks (sps.every). This sets the polling
	  granularity; task intervals shorter than this are not useful.

endmenu

source "Kconfig.zephyr"
